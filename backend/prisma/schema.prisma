generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  partner
  moderator
  admin
}

enum StationStatus {
  working
  broken
  unknown
}

enum ChargingSpeed {
  slow
  fast
  ultra_fast
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal
  converted
  rejected
}

model Integration {
  id            String   @id @default(uuid())
  key           String   @unique
  name          String
  apiKey        String?
  value         String?  // JSON конфиг (для OCPI: versionsUrl, token)
  extraConfig   Json?
  isEnabled     Boolean  @default(false)
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  name         String?
  avatarUrl    String?
  role         UserRole @default(user)
  passwordHash String?
  // Профиль
  city         String?
  bio          String?
  // Данные об электромобиле
  carBrand      String?   // Tesla, BYD, Zeekr, Li Auto...
  carModel      String?   // Model 3, Han, 001...
  carYear       Int?
  carRange      Int?      // реальный запас хода в км
  connectorType String?   // Type2, CCS2, CHAdeMO, GBT
  // Сброс пароля по email
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt    DateTime @default(now())

  stations         ChargingStation[] @relation("AddedStations")
  reviews          StationReview[]
  leads            Lead[]
  articles         Article[]
  providerReviews  ProviderReview[]
  managedProviders ServiceProvider[]
  partnerApplications PartnerApplication[]
  trips            Trip[]
}

model ChargingStation {
  id              String         @id @default(uuid())
  name            String
  networkOperator String?
  network         String?        // название сети (для OCPI)
  latitude        Float
  longitude       Float
  address         String?
  city            String?
  connectorTypes  String[]
  connectors      String[]       // алиас для OCPI маппинга
  chargingSpeed   ChargingSpeed  @default(fast)
  powerKw         Float?
  priceInfo       String?
  status          StationStatus  @default(unknown)
  photos          String[]
  verified        Boolean        @default(false)
  externalId      String?        @unique
  lastStatusUpdate DateTime?
  reportCount     Int            @default(0)  // сколько раз обновляли статус

  addedById String?
  addedBy   User?   @relation("AddedStations", fields: [addedById], references: [id])

  reviews   StationReview[]
  trips     Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([latitude, longitude])
}

model StationReview {
  id           String        @id @default(uuid())
  stationId    String
  station      ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  userId       String?       // необязательно — анонимные репорты разрешены
  user         User?         @relation(fields: [userId], references: [id])
  statusReport StationStatus
  comment      String?
  rating       Int?          // 1..5
  photos       String[]
  // Дополнительные поля для краудсорсинга
  waitMinutes  Int?          // время ожидания в очереди
  powerActual  Float?        // реальная мощность зарядки (пользователь замеряет)
  connectorOk  String?       // какой разъём работал
  createdAt    DateTime      @default(now())
}

model ServiceCategory {
  id   String @id @default(uuid())
  name String
  slug String @unique

  providers ServiceProvider[]
}

model ServiceProvider {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique // URL: /services/ev-service-moscow
  categoryId     String
  category       ServiceCategory @relation(fields: [categoryId], references: [id])

  // Основная информация
  tagline        String?         // короткий слоган под названием
  description    String?         // подробное описание (до 1000 символов)
  city           String?
  address        String?         // полный адрес
  latitude       Float?
  longitude      Float?

  // Контакты (партнёр заполняет сам)
  phone          String?
  telegram       String?         // @username или ссылка
  whatsapp       String?
  website        String?
  email          String?

  // Контент лендинга
  logoUrl        String?
  photos         String[]        // до 6 фото, загружает партнёр
  services       String[]        // список услуг: ['Диагностика батареи', 'ТО', ...]
  brands         String[]        // марки EV: ['Tesla', 'BYD', 'Zeekr', ...]
  workingHours   String?         // 'Пн–Вс 9:00–21:00'
  yearFounded    Int?            // год основания

  // Модерация и монетизация
  isPaidPlacement Boolean        @default(false)
  plan            String         @default("free") // free | partner | business | gold
  planExpiresAt   DateTime?      // когда заканчивается тариф (null = бессрочно)
  viewCount       Int            @default(0)
  viewCountWeek   Int            @default(0)
  verified        Boolean        @default(false) // проверен командой proev.ru
  isPublished     Boolean        @default(false) // партнёр опубликовал страницу
  ratingAvg       Float?
  reviewCount     Int            @default(0)

  // Владелец (партнёр с ролью partner)
  ownerId        String?
  owner          User?           @relation(fields: [ownerId], references: [id])

  leads          Lead[]
  reviews        ProviderReview[]
  posts          ProviderPost[]
  webhooks       Webhook[]
  apiKeys        ApiKey[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Блог партнёра — статьи которые он пишет сам из кабинета
model ProviderPost {
  id          String          @id @default(uuid())
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title       String
  slug        String          // уникален в рамках провайдера
  excerpt     String?         // краткое описание (для карточки)
  content     String          // HTML от Tiptap
  coverUrl    String?         // обложка
  isPublished Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([providerId, slug])
}

// Отзывы на партнёра — от пользователей proev.ru после заявки
model ProviderReview {
  id         String          @id @default(uuid())
  providerId String
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?           @relation(fields: [authorId], references: [id])
  rating     Int             // 1..5
  text       String?
  createdAt  DateTime        @default(now())
}

model Lead {
  id         String     @id @default(uuid())
  providerId String
  provider   ServiceProvider @relation(fields: [providerId], references: [id])
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])
  name       String
  phone      String
  message    String?
  status       LeadStatus @default(new)
  partnerNote  String?
  nextFollowUp DateTime?
  updatedAt    DateTime   @default(now()) @updatedAt
  history      LeadHistory[]
  createdAt    DateTime   @default(now())
}

model LeadHistory {
  id         String      @id @default(uuid())
  leadId     String
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus LeadStatus?
  toStatus   LeadStatus
  note       String?
  createdAt  DateTime    @default(now())
}

model Article {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  description  String?  // meta description + excerpt
  content      String   // HTML
  category     String?  // Зарядки, Обзоры EV, Финансы, Маршруты
  keywords     String[] // SEO keywords
  readTime     Int?     // минут на чтение
  coverImage   String?
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id])
  seoTitle     String?  // переопределяет title для SEO
  seoMeta      Json?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt])
  @@index([category])
}

enum NewsStatus {
  pending   // только что спарсили, ждёт модерации
  approved  // одобрена, видна на сайте
  rejected  // отклонена, не показывается
}

// Источник RSS-новостей — управляется через /admin -> Новости -> Источники.
// Список редактируется без передеплоя: включаешь isEnabled, и cron-задача
// начнёт забирать заголовки + выжимки от туда.
enum PartnerApplicationStatus {
  pending   // ждёт рассмотрения
  approved  // одобрена — партнёр получает доступ в кабинет
  rejected  // отклонена
}

model PartnerApplication {
  id          String                   @id @default(uuid())
  companyName String
  categoryId  String?
  city        String
  phone       String
  email       String
  description String?                  // кратко о бизнесе
  website     String?
  status      PartnerApplicationStatus @default(pending)
  rejectionReason String?              // причина отказа (видна заявителю)
  adminNote   String?                  // внутренняя заметка для модератора
  userId      String?                  // созданный пользователь после одобрения
  user        User?                    @relation(fields: [userId], references: [id])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model NewsSource {
  id            String     @id @default(uuid())
  name          String     // отображаемое имя, напр. "За рулём"
  feedUrl       String     @unique
  isEnabled     Boolean    @default(false) // включается вручную после проверки
  lastFetchedAt DateTime?
  lastError     String?    // текст последней ошибки, видно в админке
  createdAt     DateTime   @default(now())
  items         NewsItem[]
}

// Новостной дайджест: заголовок + выжимка (1-2 предл.) + ссылка на оригинал.
// Полный текст чужих статей НЕ копируется — только дайджест.
// Поле body — для редактирования/дополнения через визуальный редактор в /admin.
model NewsItem {
  id           String      @id @default(uuid())
  title        String
  excerpt      String?     // 1-2 предложения — превью на сайте
  body         String?     // HTML-контент (редактируется визуально в /admin)
  sourceUrl    String      @unique // ссылка на оригинальную статью
  sourceName   String      // "За рулём", "РБК" и т.д.
  isOriginal   Boolean     @default(false) // true = написана вручную в /admin, false = спарсена
  imageUrl     String?
  publishedAt  DateTime?
  fetchedAt    DateTime    @default(now())
  status       NewsStatus  @default(pending) // новости публикуются только после одобрения
  sourceId     String?
  source       NewsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([status])
}

// Вебхуки — партнёр указывает URL, система отправляет POST при событиях
model Webhook {
  id          String   @id @default(uuid())
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  url         String
  secret      String   // HMAC-SHA256 подпись для верификации
  events      String[] // ['lead.created', 'lead.status_changed', 'review.created']
  isActive    Boolean  @default(true)
  lastError   String?
  lastTriggeredAt DateTime?
  createdAt   DateTime @default(now())
}

// API-ключи для внешних интеграций (amoCRM, Bitrix24, и т.д.)
model ApiKey {
  id          String   @id @default(uuid())
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String   // "Мой amoCRM", "Telegram бот"
  key         String   @unique // pk_live_xxxxx
  scopes      String[] // ['leads:read', 'leads:write', 'provider:read']
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
}

// Статические страницы сайта — редактируются из AdminJS
model Page {
  id          String   @id @default(uuid())
  slug        String   @unique  // 'about' | 'pricing' | 'privacy' | 'terms' | 'partner'
  title       String
  description String?           // meta description для SEO
  content     String            // HTML из Tiptap
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Дневник поездок пользователя
model Trip {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId   String?
  station     ChargingStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  stationName String?  // если станции нет в БД
  city        String?
  fromCity    String?  // откуда (для маршрутных поездок)
  toCity      String?  // куда
  distanceKm  Int?     // расстояние маршрута
  carBrand    String?  // марка авто
  carModel    String?  // модель авто
  stops       Int?     // количество зарядных остановок
  season      String?  // сезон поездки
  chargedKwh  Float?   // заряжено кВт·ч
  durationMin Int?     // время зарядки в минутах
  speedKw     Float?   // реальная скорость зарядки кВт
  cost        Float?   // стоимость в рублях
  rating      Int?     // оценка станции 1-5
  comment     String?
  visitedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
}

// База электромобилей — управляется через AdminJS
model EVModel {
  id            String   @id @default(uuid())
  brand         String
  model         String
  year          Int
  range         Int      // запас хода км WLTP/NEDC
  consumption   Float    // кВт·ч / 100 км паспортный
  battery       Float    // кВт·ч ёмкость батареи
  connector     String   // GBT, CCS2, CHAdeMO, Type2
  maxChargeDC   Int      // макс. DC кВт
  maxChargeAC   Int?     // макс. AC кВт
  origin        String?  // китайский оригинал
  isHybrid      Boolean  @default(false)
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([brand])
  @@index([connector])
}

model SavedRoute {
  id          String   @id @default(uuid())
  code        String   @unique
  fromName    String
  fromLat     Float
  fromLon     Float
  toName      String
  toLat       Float
  toLon       Float
  distance    Int
  carBrand    String?
  carModel    String?
  consumption Float?
  battery     Float?
  speed       Int?
  season      String?
  chargeLevel Int?
  stops       Int?
  totalTimeMin Int?
  energyNeeded Float?
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([code])
}
